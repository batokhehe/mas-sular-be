generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERING
  COMPLETED
  CANCELLED
  PACKING
  SHIPPED
  DELIVERED
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  COD
  GATEWAY
}

enum PaymentStatus {
  PENDING
  WAITING_VERIFICATION
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum ShipmentStatus {
  PENDING
  RATE_SELECTED
  CREATED
  WAITING_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
  UNKNOWN
}

enum VoucherType {
  FREE_SHIPPING
  PERCENTAGE_DISCOUNT
  FIXED_DISCOUNT
}

model User {
  id            String         @id @default(uuid())
  googleId      String?        @unique
  email         String         @unique
  name          String
  avatarUrl     String?
  phone         String?
  isOnboarded   Boolean        @default(false)
  isActive      Boolean        @default(true)
  roles         UserRole[]
  addresses     Address[]
  orders        Order[]
  refreshTokens RefreshToken[]
  favorites     Favorite[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  voucherUsages VoucherUsage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  @@index([email])
  @@index([deletedAt])
}

model Admin {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  roles        AdminRole[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  admins      AdminRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model AdminRole {
  adminId String
  roleId  String
  admin   Admin  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role    Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
}

model Permission {
  id          String           @id @default(uuid())
  action      String
  subject     String
  description String?
  roles       RolePermission[]

  @@unique([action, subject])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @db.VarChar(255)
  familyId  String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

model Address {
  id            String  @id @default(uuid())
  userId        String
  label         String
  recipientName String
  phone         String
  fullAddress   String  @db.Text
  notes         String?
  latitude      Decimal @db.Decimal(10, 7)
  longitude     Decimal @db.Decimal(10, 7)
  isDefault     Boolean @default(false)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  // --- Indonesian administrative hierarchy (additive; all nullable for backward
  // compatibility — legacy addresses keep fullAddress and leave these null). ---
  addressDetail String?   @db.Text
  provinceId    String?
  cityId        String?
  districtId    String?
  villageId     String?
  postalCode    String?   @db.VarChar(5)
  province      Province? @relation(fields: [provinceId], references: [id])
  city          City?     @relation(fields: [cityId], references: [id])
  district      District? @relation(fields: [districtId], references: [id])
  village       Village?  @relation(fields: [villageId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, isDefault])
  @@index([deletedAt])
  @@index([provinceId])
  @@index([cityId])
  @@index([districtId])
  @@index([villageId])
}

// ---------------- Indonesian administrative master data ----------------

enum CityType {
  CITY
  REGENCY
}

model Province {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  isActive          Boolean            @default(true)
  cities            City[]
  addresses         Address[]
  deliveryCoverages DeliveryCoverage[]
  outlets           Outlet[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([name])
}

model City {
  id                String             @id @default(uuid())
  provinceId        String
  code              String             @unique
  name              String
  type              CityType           @default(CITY)
  isActive          Boolean            @default(true)
  province          Province           @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  districts         District[]
  addresses         Address[]
  deliveryCoverages DeliveryCoverage[]
  outlets           Outlet[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([provinceId])
  @@index([name])
}

model District {
  id                String             @id @default(uuid())
  cityId            String
  code              String             @unique
  name              String
  isActive          Boolean            @default(true)
  city              City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  villages          Village[]
  addresses         Address[]
  deliveryCoverages DeliveryCoverage[]
  outlets           Outlet[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([cityId])
  @@index([name])
}

model Village {
  id                String             @id @default(uuid())
  districtId        String
  code              String             @unique
  name              String
  postalCode        String?            @db.VarChar(5)
  isActive          Boolean            @default(true)
  district          District           @relation(fields: [districtId], references: [id], onDelete: Cascade)
  addresses         Address[]
  deliveryCoverages DeliveryCoverage[]
  outlets           Outlet[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([districtId])
  @@index([name])
  @@index([postalCode])
}

enum CoverageType {
  DELIVERY
  PICKUP_ONLY
  DISABLED
}

model DeliveryCoverage {
  id               String       @id @default(uuid())
  provinceId       String
  cityId           String
  districtId       String?
  villageId        String?
  coverageType     CoverageType @default(DELIVERY)
  deliveryFee      Int          @default(0)
  minimumOrder     Int          @default(0)
  estimatedMinutes Int          @default(60)
  isActive         Boolean      @default(true)
  province         Province     @relation(fields: [provinceId], references: [id])
  city             City         @relation(fields: [cityId], references: [id])
  district         District?    @relation(fields: [districtId], references: [id])
  village          Village?     @relation(fields: [villageId], references: [id])
  orders           Order[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Lookup index for the village→district→city resolution walk.
  @@index([provinceId, cityId, districtId, villageId])
  @@index([isActive])
}

/// Outlet / origin configuration (System Settings). Shipping providers always use
/// the single active outlet as the origin. Exactly one row is active at a time.
model Outlet {
  id            String                 @id @default(uuid())
  name          String
  addressDetail String?                @db.Text
  provinceId    String?
  cityId        String?
  districtId    String?
  villageId     String?
  postalCode    String?                @db.VarChar(5)
  latitude      Decimal?               @db.Decimal(10, 7)
  longitude     Decimal?               @db.Decimal(10, 7)
  isActive      Boolean                @default(false)
  province      Province?              @relation(fields: [provinceId], references: [id])
  city          City?                  @relation(fields: [cityId], references: [id])
  district      District?              @relation(fields: [districtId], references: [id])
  village       Village?               @relation(fields: [villageId], references: [id])
  reservations  InventoryReservation[]
  inventories   ProductInventory[]
  transfersFrom StockTransfer[]        @relation("TransferFrom")
  transfersTo   StockTransfer[]        @relation("TransferTo")
  orders        Order[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([isActive])
}

model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  icon      String?
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Product {
  id            String                 @id @default(uuid())
  slug          String                 @unique
  sku           String                 @unique
  name          String
  description   String                 @db.Text
  price         Int
  originalPrice Int?
  imageUrl      String
  rating        Decimal                @default(0) @db.Decimal(3, 2)
  reviewCount   Int                    @default(0)
  spicyLevel    Int?
  isBestSeller  Boolean                @default(false)
  isNew         Boolean                @default(false)
  status        ProductStatus          @default(ACTIVE)
  stock         Int                    @default(0)
  categoryId    String
  category      Category               @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  favorites     Favorite[]
  reservations  InventoryReservation[]
  inventories   ProductInventory[]
  transfers     StockTransfer[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deletedAt     DateTime?

  @@index([categoryId, status])
  @@index([isBestSeller])
  @@index([deletedAt])
}

model Topping {
  id         String             @id @default(uuid())
  name       String
  price      Int
  isActive   Boolean            @default(true)
  orderItems OrderItemTopping[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
}

model Favorite {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model Promo {
  id                    String         @id @default(uuid())
  code                  String         @unique
  title                 String
  description           String         @db.Text
  imageUrl              String?
  voucherType           VoucherType    @default(PERCENTAGE_DISCOUNT)
  discountPercentage    Int?           @db.UnsignedInt
  discountAmount        Int?           @db.UnsignedInt
  maxDiscountAmount     Int?           @db.UnsignedInt
  freeShippingMaxAmount Int?           @db.UnsignedInt
  minimumOrderAmount    Int            @default(0)
  maxUsageCount         Int?           @db.UnsignedInt
  currentUsageCount     Int            @default(0)
  isNewUserOnly         Boolean        @default(false)
  isActive              Boolean        @default(true)
  startDate             DateTime?
  endDate               DateTime?
  usages                VoucherUsage[]
  orders                Order[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
}

model VoucherUsage {
  id        String   @id @default(uuid())
  voucherId String
  userId    String
  orderId   String   @unique
  voucher   Promo    @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([voucherId, userId])
  @@index([userId, voucherId])
  @@index([createdAt])
}

model CartSession {
  id        String   @id @default(uuid())
  userId    String?
  token     String   @unique
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Order {
  id                       String                 @id @default(uuid())
  orderNumber              String                 @unique
  userId                   String
  addressId                String
  voucherId                String?
  voucherCode              String?
  voucherType              VoucherType?
  status                   OrderStatus            @default(PENDING)
  subtotal                 Int
  voucherDiscountAmount    Int                    @default(0)
  deliveryFee              Int
  totalPrice               Int
  paymentMethod            PaymentMethod
  notes                    String?
  estimatedDelivery        DateTime?
  // Delivery-coverage snapshot (nullable — legacy orders predate coverage).
  coverageId               String?
  estimatedDeliveryMinutes Int?
  // Selected shipping-provider quote snapshot (nullable — legacy orders predate it).
  shippingProvider         String?
  shippingService          String?
  shippingServiceName      String?
  shippingCost             Int?
  trackingNumber           String?
  shippingPayload          Json?
  // Allocated fulfillment outlet (multi-outlet allocation; null on legacy orders).
  outletId                 String?
  user                     User                   @relation(fields: [userId], references: [id])
  address                  Address                @relation(fields: [addressId], references: [id])
  voucher                  Promo?                 @relation(fields: [voucherId], references: [id])
  coverage                 DeliveryCoverage?      @relation(fields: [coverageId], references: [id])
  outlet                   Outlet?                @relation(fields: [outletId], references: [id])
  items                    OrderItem[]
  payment                  Payment?
  shipment                 Shipment?
  events                   OrderEvent[]
  voucherUsage             VoucherUsage?
  reservations             InventoryReservation[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  deletedAt                DateTime?

  @@index([userId, status])
  @@index([createdAt])
  @@index([coverageId])
}

model OrderItem {
  id          String             @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Int
  quantity    Int
  spicyLevel  Int?
  notes       String?
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id])
  toppings    OrderItemTopping[]
}

model OrderItemTopping {
  orderItemId String
  toppingId   String
  name        String
  price       Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  topping     Topping   @relation(fields: [toppingId], references: [id])

  @@id([orderItemId, toppingId])
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  metadata  Json?
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model Payment {
  id                String               @id @default(uuid())
  orderId           String               @unique
  method            PaymentMethod
  status            PaymentStatus        @default(PENDING)
  amount            Int
  provider          String?
  providerReference String?
  manualBankName    String?
  manualAccountName String?
  manualReceiptUrl  String?
  verifiedByUserId  String?
  verifiedAt        DateTime?
  firstReminderAt   DateTime?
  secondReminderAt  DateTime?
  webhookPayload    Json?
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  uploadTokens      PaymentUploadToken[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  @@index([status, method])
  @@index([status, method, createdAt])
}

/// Single-use, expiring capability token that lets an unauthenticated customer
/// upload a payment receipt via a link (no login). Only the SHA-256 hash of the
/// URL secret is stored; the raw secret lives only in the emailed link.
model PaymentUploadToken {
  id        String    @id @default(uuid())
  token     String    @unique @db.VarChar(64)
  paymentId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([expiresAt])
}

model PaymentAccount {
  id            String   @id @default(uuid())
  bankName      String
  bankCode      String?
  accountName   String
  accountNumber String   @unique
  logoUrl       String?
  notes         String?  @db.Text
  isActive      Boolean  @default(false)
  isVisible     Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([isVisible])
  @@index([displayOrder])
}

model Transaction {
  id                String        @id @default(uuid())
  paymentId         String
  status            PaymentStatus
  amount            Int
  providerReference String?
  rawPayload        Json?
  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@index([paymentId, createdAt])
}

model Shipment {
  id                 String            @id @default(uuid())
  orderId            String            @unique
  provider           String
  service            String
  status             ShipmentStatus    @default(PENDING)
  cost               Int
  trackingNumber     String?
  trackingUrl        String?
  // Provider shipment-creation snapshot (set once payment is PAID).
  providerShipmentId String?
  providerPayload    Json?
  metadata           Json?
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  history            ShipmentHistory[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

/// Append-only audit of every shipment status transition (provider → internal).
model ShipmentHistory {
  id             String         @id @default(uuid())
  shipmentId     String
  providerStatus String
  mappedStatus   ShipmentStatus
  changedAt      DateTime
  createdAt      DateTime       @default(now())
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, changedAt])
}

// ---------------- Inventory reservation & stock allocation ----------------

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
  CANCELLED
}

/// A hold on stock for an order item. Available stock = Product.stock - active
/// RESERVED qty. Committed at payment verification (deducts Product.stock),
/// released on expiry / cancel / reject.
model InventoryReservation {
  id               String                        @id @default(uuid())
  orderId          String
  productId        String
  productVariantId String?
  outletId         String?
  reservedQty      Int
  committedQty     Int                           @default(0)
  releasedQty      Int                           @default(0)
  status           ReservationStatus             @default(RESERVED)
  expiresAt        DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  order            Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product                       @relation(fields: [productId], references: [id])
  outlet           Outlet?                       @relation(fields: [outletId], references: [id])
  history          InventoryReservationHistory[]

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([productId, status])
  @@index([outletId])
}

/// Append-only audit of every reservation status transition (timeline).
model InventoryReservationHistory {
  id            String               @id @default(uuid())
  reservationId String
  status        ReservationStatus
  note          String?
  createdAt     DateTime             @default(now())
  reservation   InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

// ---------------- Multi-outlet inventory & transfers ----------------

/// Per-outlet stock — the source of truth for physical inventory. `available` =
/// stock − reserved, maintained on every reservation mutation. Product.stock is
/// retained temporarily for backward compatibility.
model ProductInventory {
  id        String   @id @default(uuid())
  productId String
  outletId  String
  stock     Int      @default(0)
  reserved  Int      @default(0)
  available Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([productId, outletId])
  @@index([outletId])
  @@index([productId])
}

enum StockTransferStatus {
  REQUESTED
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

/// A stock movement between two outlets. Timeline: Requested → Approved → Completed.
model StockTransfer {
  id           String                 @id @default(uuid())
  productId    String
  fromOutletId String
  toOutletId   String
  quantity     Int
  status       StockTransferStatus    @default(REQUESTED)
  note         String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  product      Product                @relation(fields: [productId], references: [id])
  fromOutlet   Outlet                 @relation("TransferFrom", fields: [fromOutletId], references: [id])
  toOutlet     Outlet                 @relation("TransferTo", fields: [toOutletId], references: [id])
  history      StockTransferHistory[]

  @@index([status])
  @@index([productId])
}

model StockTransferHistory {
  id         String              @id @default(uuid())
  transferId String
  status     StockTransferStatus
  note       String?
  createdAt  DateTime            @default(now())
  transfer   StockTransfer       @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId, createdAt])
}

model Banner {
  id          String    @id @default(uuid())
  title       String
  description String?
  imageUrl    String
  href        String?
  placement   String
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([placement, isActive])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @db.VarChar(32)
  aggregateId   String       @db.VarChar(36)
  eventName     String       @db.VarChar(128)
  eventVersion  Int          @default(1)
  exchange      String       @db.VarChar(128)
  routingKey    String       @db.VarChar(128)
  payload       Json
  metadata      Json?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0) @db.UnsignedInt
  maxAttempts   Int          @default(10) @db.UnsignedInt
  nextAttemptAt DateTime     @default(now())
  lockedUntil   DateTime?
  lockedBy      String?      @db.VarChar(64)
  lastError     String?      @db.Text
  occurredAt    DateTime
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([aggregateId, createdAt])
  @@index([status, createdAt])
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model IdempotencyKey {
  id                  String            @id @default(uuid())
  userId              String            @db.VarChar(36)
  idempotencyKey      String            @db.VarChar(255)
  requestMethod       String            @db.VarChar(8)
  endpoint            String            @db.VarChar(128)
  requestFingerprint  String            @db.VarChar(64)
  status              IdempotencyStatus @default(PROCESSING)
  fenceToken          Int               @default(1) @db.UnsignedInt
  ownerId             String?           @db.VarChar(64)
  ownershipAcquiredAt DateTime?
  responseStatusCode  Int?
  responseBody        Json?
  resourceType        String?           @db.VarChar(64)
  resourceId          String?           @db.VarChar(36)
  lastError           String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  expiresAt           DateTime

  @@unique([userId, idempotencyKey])
  @@index([expiresAt])
  @@index([status, createdAt])
}

model ProcessedEvent {
  consumer    String   @db.VarChar(64)
  messageId   String   @db.VarChar(36)
  eventName   String   @db.VarChar(128)
  processedAt DateTime @default(now())

  @@id([consumer, messageId])
  @@index([processedAt])
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationOutbox {
  id                String              @id @default(uuid())
  channel           NotificationChannel
  recipient         String              @db.VarChar(255)
  template          String              @db.VarChar(128)
  payload           Json
  status            NotificationStatus  @default(PENDING)
  attempts          Int                 @default(0) @db.UnsignedInt
  nextAttemptAt     DateTime            @default(now())
  lockedUntil       DateTime?
  lockedBy          String?             @db.VarChar(64)
  providerMessageId String?             @db.VarChar(255)
  lastError         String?             @db.Text
  sourceMessageId   String?             @db.VarChar(36)
  createdAt         DateTime            @default(now())
  sentAt            DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([status, sentAt])
  @@index([status, createdAt])
}
