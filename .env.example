# =============================================================================
# Mas Sular backend — environment template
# Validated at startup by src/common/config/env.validation.ts (fail-fast).
# Copy to .env and fill in. Required vars MUST be set or the app will not boot.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                 # development | test | staging | production
SWAGGER_ENABLED=false                # /docs is auto-disabled in production; set true to opt back in
PORT=3001

# --- Core infrastructure (REQUIRED in every environment) -------------------
# P0-2: size the Prisma pool EXPLICITLY in production — the default (2*CPU+1 per
# instance) is shared by HTTP traffic AND all workers AND 10s interactive
# transactions, and under load exhausts silently as P2024 timeouts.
#   connection_limit  connections per app instance. Size so that
#                     instances * connection_limit < MySQL max_connections (keep headroom).
#   pool_timeout      seconds a request waits for a free connection before P2024 (default 10).
# Production example:
#   DATABASE_URL=mysql://user:pass@host:3306/db?connection_limit=15&pool_timeout=20
DATABASE_URL=mysql://baso:baso_secret@localhost:3306/baso_nusantara
REDIS_URL=redis://localhost:6379

# --- Auth secrets (REQUIRED; each >= 32 chars, unique, no dev placeholders) -
JWT_ACCESS_SECRET=change-me-to-a-unique-32+char-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-32+char-random-string
JWT_ADMIN_ACCESS_SECRET=change-me-to-another-32+char-random-string
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=30d
JWT_ADMIN_ACCESS_TTL=1d
GOOGLE_CLIENT_ID=your-google-oauth-client-id            # REQUIRED (customer login)

# --- URLs (REQUIRED: APP_URL must be a valid URL) --------------------------
APP_URL=http://localhost:3001                            # base for /uploads/<file> receipt URLs
PAYMENT_UPLOAD_BASE_URL=http://localhost:3000            # OPTIONAL; if set, must be a valid URL (emailed link base)

# --- CORS (REQUIRED in staging/production; explicit allowlist, no "*") ------
CORS_ORIGINS=http://localhost:3000
COOKIE_SECRET=change-me                                  # recommended in staging/production

# --- Checkout idempotency (OFF by default → enable to protect checkout) -----
CHECKOUT_IDEMPOTENCY_ENABLED=false                       # set true to make /checkout/order idempotent
CHECKOUT_IDEMPOTENCY_REQUIRED=false                      # true requires *_ENABLED=true (else boot fails)

# Manual BANK_TRANSFER unique code (folded into the transfer total for easier reconciliation).
# Disabled by default → checkout behaves exactly as before. Range: min >= 0, max <= 999, max > min.
PAYMENT_UNIQUE_CODE_ENABLED=true                         # only affects BANK_TRANSFER (not QRIS/COD/gateway)
PAYMENT_UNIQUE_CODE_MIN=100
PAYMENT_UNIQUE_CODE_MAX=999

# Admin notification platform (bell / SSE / web push). Consumer rides CONSUMERS_ENABLED.
FIREBASE_SERVICE_ACCOUNT_JSON=                            # OPTIONAL; service-account JSON string → enables FCM web push
NOTIFICATION_RETENTION_ENABLED=true
NOTIFICATION_RETENTION_DAYS=90                            # delete admin notifications older than this
PUSH_TOKEN_STALE_DAYS=60                                  # remove push tokens not seen for this long
NOTIFICATION_RETENTION_BATCH_SIZE=1000                    # rows per LIMIT-batched retention delete (P0-3)
SSE_MAX_CONNECTION_AGE_MINUTES=60                         # ML-1: recycle SSE connections after this lifetime (client auto-reconnects)

# --- Midtrans payment gateway (Phase 3) -------------------------------------
# OFF by default: with MIDTRANS_ENABLED=false the provider is not registered,
# every gateway channel stays unavailable, and /payments/channels returns manual
# transfer only — identical to pre-gateway behavior.
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=                    # REQUIRED when enabled (server-side secret)
MIDTRANS_CLIENT_KEY=                    # published to the browser for card tokenisation
MIDTRANS_IS_PRODUCTION=false            # false -> sandbox Core API base URL is used
# THE single source of truth for the Core API endpoint. Leave EMPTY to use the
# default derived from MIDTRANS_IS_PRODUCTION (sandbox vs production Core API) —
# that is the normal case for every environment. Set it explicitly only when a
# deployment must reach Midtrans through a custom/proxy endpoint. Never hardcode a
# deployment-specific URL in application source; supply it here or through the
# deployment environment. Boot refuses a sandbox/production mismatch in either
# direction. NOT related to the webhook URL, which derives from APP_URL.
MIDTRANS_BASE_URL=
MIDTRANS_TIMEOUT_MS=10000               # per-attempt HTTP timeout
MIDTRANS_MAX_RETRY=2                    # retries on 429/500/502/503/504 only

# Enterprise logging center (SystemLog). Additive; safe to leave at defaults.
SYSTEM_LOG_ENABLED=true                                   # persist structured logs to the DB
SYSTEM_LOG_RETENTION_ENABLED=true                        # run the daily retention sweep
LOG_RETENTION_DAYS=90                                    # delete SystemLog rows older than this

# --- Async pipeline (all OFF by default) -----------------------------------
# RABBITMQ_URL is REQUIRED when OUTBOX_RELAY_ENABLED or CONSUMERS_ENABLED is true.
RABBITMQ_URL=amqp://baso:baso_secret@localhost:5672
OUTBOX_RELAY_ENABLED=false
CONSUMERS_ENABLED=false

# --- Notification sender / Resend (RESEND_API_KEY + EMAIL_FROM required when ON) -
NOTIFICATION_SENDER_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=orders@masular.example
ADMIN_NOTIFICATION_EMAIL=ops@masular.example             # recipient for "new receipt to verify"

# --- Notification provider routing + WhatsApp (Mekari Qontak) ----------------
# multi (route by channel, default) | email (force email) | qontak (force WhatsApp)
NOTIFICATION_PROVIDER=multi
# REQUIRED when NOTIFICATION_SENDER_ENABLED=true and NOTIFICATION_PROVIDER != email:
QONTAK_API_TOKEN=
QONTAK_CHANNEL_INTEGRATION_ID=
QONTAK_ORDER_TEMPLATE_ID=                                 # transfer (bank + upload button) template
QONTAK_COD_TEMPLATE_ID=                                   # COD template
QONTAK_BASE_URL=https://service-chat.qontak.com          # optional; must be a valid URL
QONTAK_TIMEOUT_MS=10000                                   # optional
QONTAK_MAX_RETRY=1                                        # optional; in-call retries (durable outbox retry is authoritative)

# --- Payment lifecycle (reminder + expiry; OFF by default) ------------------
# Windows must satisfy FIRST < SECOND < EXPIRY (validated at startup).
PAYMENT_LIFECYCLE_ENABLED=false
PAYMENT_FIRST_REMINDER_MS=86400000                       # 24h
PAYMENT_SECOND_REMINDER_MS=172800000                     # 48h
PAYMENT_EXPIRY_MS=259200000                              # 72h (BANK_TRANSFER/QRIS)
PAYMENT_GATEWAY_EXPIRY_MS=259200000                      # 0 = gateway never expires

# --- Retention (OFF by default) --------------------------------------------
RETENTION_ENABLED=false
RETENTION_DRY_RUN=false
# RETENTION_*_DAYS, RETENTION_BATCH_SIZE, etc. have safe defaults (see lifecycle.config.ts)

# --- Observability ---------------------------------------------------------
APP_VERSION=0.1.0                                        # surfaced as masular_build_info

# --- Shipping providers (Paxel / JNE; OFF by default) ----------------------
# When a provider is ENABLED, its credentials are required (validated at boot).
# Never commit real keys. Disabled providers simply contribute no quotes.
SHIPPING_ORIGIN_POSTAL_CODE=40111                        # store origin postal code
PAXEL_ENABLED=false
PAXEL_BASE_URL=https://api.paxel.co                      # optional; provider base URL
PAXEL_API_KEY=                                           # required when PAXEL_ENABLED=true
PAXEL_API_SECRET=                                        # required when PAXEL_ENABLED=true; signs X-Paxel-Signature. Never commit a real value.
PAXEL_ORIGIN_PHONE=                                      # required when PAXEL_ENABLED=true; merchant pickup contact, 9-13 digits, no spaces or +
PAXEL_ORIGIN_NOTE=                                       # required when PAXEL_ENABLED=true; pickup instruction for the courier. No default - write a real one.
PAXEL_NEED_INSURANCE=false                               # optional; Paxel shipment insurance. Costs money per shipment - stays off unless set to true.
PAXEL_DEFAULT_DIMENSION=30x35x20                         # required when PAXEL_ENABLED=true; parcel LxWxH in cm (1x1x1..50x50x50).
                                                         # Paxel prices from this, so changing it changes what customers are quoted.
PAXEL_TIMEOUT_MS=8000                                    # optional
PAXEL_MAX_RETRY=2                                        # optional; in-call retries on transient errors
JNE_ENABLED=false
# Which JNE tenant to address. Absent means sandbox - never production.
# With JNE_ENVIRONMENT=production, JNE_BASE_URL is REQUIRED and must not be the
# known sandbox endpoint (apiv2.jne.co.id:10202). There is no production default:
# JNE has not supplied a production endpoint, so it must be named explicitly.
JNE_ENVIRONMENT=sandbox                                 # optional; sandbox | production
JNE_BASE_URL=https://apiv2.jne.co.id:10102              # optional in sandbox; required in production
JNE_API_KEY=                                            # required when JNE_ENABLED=true
JNE_USERNAME=                                           # required when JNE_ENABLED=true
JNE_ORIGIN_CODE=                                        # required when JNE_ENABLED=true (JNE origin city code)
JNE_TIMEOUT_MS=8000                                     # optional
JNE_MAX_RETRY=2                                         # optional

# --- Shipment fulfillment & tracking (OFF by default) ----------------------
# Shipment creation reuses PAXEL_*/JNE_* credentials above. Tracking worker polls
# the courier for non-terminal shipments and updates order status.
SHIPMENT_TRACKING_ENABLED=false
SHIPMENT_TRACKING_POLL_INTERVAL_MS=300000                 # 5 min
SHIPMENT_TRACKING_BATCH_SIZE=50
# Qontak WhatsApp templates for shipment notifications (required only when that
# template is actually sent, i.e. NOTIFICATION_SENDER_ENABLED + provider=qontak/multi).
QONTAK_SHIPPED_TEMPLATE_ID=                               # "Pesanan Anda telah dikirim"
QONTAK_DELIVERED_TEMPLATE_ID=                             # delivery confirmation
QONTAK_SHIPMENT_TEMPLATE_ID=                              # generic shipment status update
QONTAK_MANUAL_TEMPLATE_ID=                                # optional; approved free-text template ({{1}}=message) for admin manual sends

# --- Inventory reservation worker (releases expired holds; OFF by default) --
INVENTORY_RESERVATION_WORKER_ENABLED=false
INVENTORY_RESERVATION_POLL_MS=60000
INVENTORY_RESERVATION_INITIAL_DELAY_MS=30000
INVENTORY_RESERVATION_BATCH_SIZE=100
INVENTORY_RESERVATION_HEALTH_LOG_MS=300000

# --- Shipment reconciliation worker (recover paid-but-unbooked shipments; OFF by default) ---
SHIPMENT_RECONCILIATION_ENABLED=false
SHIPMENT_RECONCILIATION_INTERVAL_MS=60000
SHIPMENT_RECONCILIATION_BATCH_SIZE=50
SHIPMENT_RECONCILIATION_DELAY_MS=120000

# --- Midtrans reconciliation worker (Phase 5E) -------------------------------
# Recovers gateway charges whose webhook never arrived (or arrived while the
# Status API was down). Reads the authoritative status and routes it through the
# SAME transition the webhook uses. OFF by default; never auto-enable in prod.
MIDTRANS_RECONCILIATION_ENABLED=false
MIDTRANS_RECONCILIATION_INTERVAL_MS=60000        # sweep cadence
MIDTRANS_RECONCILIATION_INITIAL_DELAY_MS=30000   # settle-in delay after boot
MIDTRANS_RECONCILIATION_BATCH_SIZE=50            # bounded batch per sweep
# Grace period ONLY, so a sweep cannot race the charge request or an in-flight
# webhook. This is NOT a business expiry window — PAYMENT_GATEWAY_EXPIRY_AFTER_MS
# still owns that. Mirrors SHIPMENT_RECONCILIATION_DELAY_MS.
MIDTRANS_RECONCILIATION_MIN_AGE_MS=120000
MIDTRANS_RECONCILIATION_HEALTH_LOG_MS=300000
