# =============================================================================
# Mas Sular backend — environment template
# Validated at startup by src/common/config/env.validation.ts (fail-fast).
# Copy to .env and fill in. Required vars MUST be set or the app will not boot.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development                 # development | test | staging | production
PORT=3001

# --- Core infrastructure (REQUIRED in every environment) -------------------
DATABASE_URL=mysql://baso:baso_secret@localhost:3306/baso_nusantara
REDIS_URL=redis://localhost:6379

# --- Auth secrets (REQUIRED; each >= 32 chars, unique, no dev placeholders) -
JWT_ACCESS_SECRET=change-me-to-a-unique-32+char-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-32+char-random-string
JWT_ADMIN_ACCESS_SECRET=change-me-to-another-32+char-random-string
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=30d
JWT_ADMIN_ACCESS_TTL=1d
GOOGLE_CLIENT_ID=your-google-oauth-client-id            # REQUIRED (customer login)

# --- URLs (REQUIRED: APP_URL must be a valid URL) --------------------------
APP_URL=http://localhost:3001                            # base for /uploads/<file> receipt URLs
PAYMENT_UPLOAD_BASE_URL=http://localhost:3000            # OPTIONAL; if set, must be a valid URL (emailed link base)

# --- CORS (REQUIRED in staging/production; explicit allowlist, no "*") ------
CORS_ORIGINS=http://localhost:3000
COOKIE_SECRET=change-me                                  # recommended in staging/production

# --- Checkout idempotency (OFF by default → enable to protect checkout) -----
CHECKOUT_IDEMPOTENCY_ENABLED=false                       # set true to make /checkout/order idempotent
CHECKOUT_IDEMPOTENCY_REQUIRED=false                      # true requires *_ENABLED=true (else boot fails)

# --- Async pipeline (all OFF by default) -----------------------------------
# RABBITMQ_URL is REQUIRED when OUTBOX_RELAY_ENABLED or CONSUMERS_ENABLED is true.
RABBITMQ_URL=amqp://baso:baso_secret@localhost:5672
OUTBOX_RELAY_ENABLED=false
CONSUMERS_ENABLED=false

# --- Notification sender / Resend (RESEND_API_KEY + EMAIL_FROM required when ON) -
NOTIFICATION_SENDER_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=orders@masular.example
ADMIN_NOTIFICATION_EMAIL=ops@masular.example             # recipient for "new receipt to verify"

# --- Payment lifecycle (reminder + expiry; OFF by default) ------------------
# Windows must satisfy FIRST < SECOND < EXPIRY (validated at startup).
PAYMENT_LIFECYCLE_ENABLED=false
PAYMENT_FIRST_REMINDER_MS=86400000                       # 24h
PAYMENT_SECOND_REMINDER_MS=172800000                     # 48h
PAYMENT_EXPIRY_MS=259200000                              # 72h (BANK_TRANSFER/QRIS)
PAYMENT_GATEWAY_EXPIRY_MS=259200000                      # 0 = gateway never expires

# --- Retention (OFF by default) --------------------------------------------
RETENTION_ENABLED=false
RETENTION_DRY_RUN=false
# RETENTION_*_DAYS, RETENTION_BATCH_SIZE, etc. have safe defaults (see lifecycle.config.ts)

# --- Observability ---------------------------------------------------------
APP_VERSION=0.1.0                                        # surfaced as masular_build_info
